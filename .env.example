# Copy to .env and adjust. Never commit real secrets.
DATABASE_URL=postgres://crm:crm@127.0.0.1:5432/crm_dev
TEST_DATABASE_URL=postgres://crm:crm@127.0.0.1:5432/crm_test
PORT=3000
NODE_ENV=development
# Origin of the web app (used for invite links)
APP_URL=http://localhost:5173

# Email (invitations, activity reminders). Without SMTP_HOST, messages are printed to the server log instead of sent.
# EMAIL_TRANSPORT=smtp            # console | smtp  (default: smtp when SMTP_HOST is set, otherwise console)
# EMAIL_FROM=Acme CRM <crm@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                   # 587/25 = STARTTLS, 465 = TLS
# SMTP_SECURE=false               # default: true only for port 465
# SMTP_USER=
# SMTP_PASS=                      # set real credentials in the environment or .env only, never in the repository

# Attachments are stored on disk here (default: ./data/files, outside the web root). Back this folder up.
# FILES_DIR=/var/lib/acme-crm/files
# FILES_MAX_BYTES=10485760

# Webhooks (automation "Call a webhook"): development only, ignored in production.
# WEBHOOK_ALLOW_HTTP=true
# WEBHOOK_ALLOW_PRIVATE=true

# Attachments in S3-compatible storage instead of the server disk (AWS S3, MinIO, Cloudflare R2, Backblaze B2, …).
# FILES_STORAGE=s3
# S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
# S3_REGION=eu-central-1
# S3_BUCKET=my-crm-files
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false   # true for MinIO and most self-hosted servers
# S3_PREFIX=crm/

# Scan uploads with a ClamAV daemon (clamd). When set, uploads are refused while the scanner is unreachable.
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
