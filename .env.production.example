# Production settings for docker-compose.prod.yml. Copy to .env on the server and fill in. Never commit the real file.
DOMAIN=crm.example.com
# A long random password for the database (letters and digits only, so it fits in a URL).
POSTGRES_PASSWORD=
# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts channel tokens (Telegram, Meta). Back it up with the database; losing it means reconnecting channels.
SECRETS_KEY=
# Who may create a workspace with the sign-up page: first (default: only the first one; everyone else is invited),
# closed, or open.
# SIGNUP=first

# Email (invitations, reminders, quotes). Without SMTP_HOST, emails are only written to the log.
EMAIL_FROM=Acme CRM <crm@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Optional: attachments in S3-compatible storage instead of the server disk (see .env.example for all options).
# FILES_STORAGE=s3
# Optional: video calls behind strict firewalls need a TURN server (see docs/HANDOFF.md).
# CALL_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
